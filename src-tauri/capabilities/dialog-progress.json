{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dialog-progress",
  "description": "Minimum permissions for the owned non-closable progress dialog",
  "local": true,
  "windows": ["dialog-opening-progress"],
  "permissions": [
    "owned-dialog-window-commands",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
