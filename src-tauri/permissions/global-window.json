{
  "permission": [
    {
      "identifier": "global-window-commands",
      "description": "Allows validating, creating, or opening Projetos, selecting provisional Imagens decorativas, reading local Tela de Boas-vindas state, and managing Cache only from the global window.",
      "commands": {
        "allow": [
          "complete_graphics_gate",
          "validate_project_configuration",
          "create_project",
          "choose_provisional_decorative",
          "release_provisional_decorative",
            "open_project",
            "save_external_copy_as",
            "recent_projects",
            "open_recent_project",
            "show_project_failure_dialog",
            "startup_open_failure",
            "latest_global_activation_terminal",
            "clear_provisional_decoratives",
            "cache_service_status",
            "free_closed_project_cache",
            "clear_all_cache"
        ],
        "deny": []
      }
    }
  ]
}
