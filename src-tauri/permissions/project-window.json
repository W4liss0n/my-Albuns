{
  "permission": [
    {
      "identifier": "project-window-commands",
      "description": "Allows only the application commands used by local Janelas de Projeto.",
      "commands": {
        "allow": [
          "frontend_log",
          "project_ui_ready",
          "project_state",
          "validate_album_information",
          "apply_project_intent",
          "import_photo",
          "photo_drop_target",
          "relink_media",
          "retry_unavailable_media",
          "undo_project",
          "redo_project",
          "save_project",
          "save_project_as",
          "request_project_close",
          "resolve_project_close",
          "present_project_dialog",
          "dismiss_project_dialog",
          "prepare_media_previews",
          "export_sheet",
          "cancel_export",
          "workspace_preferences",
          "update_workspace_preference",
          "application_settings",
          "update_application_setting"
        ],
        "deny": []
      }
    }
  ]
}
